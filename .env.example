# Configure these in the Anomali feed runner's secret/environment store.
CYBLE_API_TOKEN=
CYBLE_COMPANY_UUID=
CYBLE_SERVICES=all

TS_USERNAME=
TS_API_KEY=
TS_API_URL=
TS_FEED_ID=
TS_FEED_NAME=
TS_BATCH_SIZE=1000

CYBLE_INITIAL_LOOKBACK_HOURS=24
CYBLE_PAGE_SIZE=200
CYBLE_MAX_PAGES_PER_SERVICE=100
CYBLE_OVERLAP_SECONDS=300
CYBLE_WINDOW_MINUTES=60
CYBLE_SETTLE_SECONDS=60
CYBLE_SYNC_UPDATED_ALERTS=true
CYBLE_WITH_DATA_MESSAGE=true
# full preserves all source values, including sensitive breach data, in private bulletins.
# redacted retains the previous sanitization policy.
CYBLE_CONTENT_MODE=full
CYBLE_THREAT_TYPE=malware
CYBLE_TLP=amber
CYBLE_MAX_RUN_MINUTES=20
CYBLE_MAX_REPORT_BYTES=4194304
CYBLE_FIELD_MAP_PATH=
CYBLE_LOCK_DIR=
LOG_LEVEL=INFO
